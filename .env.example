# =============================================================================
# QDII 基金罗盘 — 环境变量模板
# 复制为 .env 后填入真实值。详见 README「配置说明：两套 Key 与最低要求」
# =============================================================================

# --- 必填：缺任一项服务无法启动 ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxx

# --- BYOK（用户自带百炼 Key）---
# 登录用户在「模型设置」里填自己的 Key 时，服务端用此密钥加密存库。
# 生成：openssl rand -hex 32（64 位 hex）
# 上线后不可更改，否则已保存的用户 Key 无法解密。
# 留空：服务能启动，但用户无法在「模型设置」里保存 Key。
AI_KEY_SECRET=

# --- 数据刷新授权（v1.7.1）---
# 全量重抓（GET /api/funds?refresh=1）需要授权：请求带 x-refresh-token = 此值，或后台管理员登录态。
# 留空：只接受本机直连（127.0.0.1、未经反代）的刷新请求——cron 打本机端口仍可用，公网无法触发。
# 生成：openssl rand -hex 16
DATA_REFRESH_TOKEN=
# 两次全量刷新之间的最短间隔（毫秒，默认 10 分钟）；间隔内的刷新请求直接返回现有数据
# DATA_REFRESH_COOLDOWN_MS=600000

# --- 平台 Key（可选）---
# 部署者自己的百炼 Key。用于：批量短长评、向量入库/检索、AI 热议等后台能力。
# 留空：基金浏览、用户 BYOK 聊天仍可用；向量检索与批量 AI 脚本不可用或降级。
# 注意：AI 投顾对话走用户自己的 Key，不走本项（v1.6 BYOK）。
DASHSCOPE_API_KEY=

# 接口地址：默认百炼官方；若 key 来自其它网关/中转平台，填该平台的 Base URL（不带末尾斜杠）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 平台侧模型链：批量生成短长评、热议、embedding 等运营脚本使用（非用户聊天）
DASHSCOPE_CHAT_MODELS=qwen3.7-plus,qwen-plus-2025-07-28,qwen3-max,qwen3.5-plus-2026-02-15
# 单点兜底（少数未走模型链的直连调用）
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_MODEL_STRONG=qwen3-max
DASHSCOPE_ENABLE_THINKING=0
DASHSCOPE_THINKING_BUDGET=1200

# 向量嵌入（npm run data:embed 与聊天语义检索；需配 DASHSCOPE_API_KEY）
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# DASHSCOPE_EMBEDDING_DIM=1024

# --- 超时与限流（可选，有默认值）---
# 东方财富 / Tavily 等抓取请求超时（毫秒）
# FETCH_TIMEOUT_MS=15000
# 百炼非流式 / 流式调用超时（毫秒）
# DASHSCOPE_TIMEOUT_MS=90000
# DASHSCOPE_STREAM_TIMEOUT_MS=180000
# 聊天接口每用户每分钟最多请求数
# AGENT_RATE_LIMIT=20

# --- 可选 ---
# 服务端口（默认 5173；生产用 PM2 时按需改）
# PORT=5173
# 定时刷新脚本访问的服务地址（默认 http://127.0.0.1:$PORT）
# APP_BASE_URL=

# Tavily 联网搜索（留空则事件类问题降级）
TAVILY_API_KEY=

# 首页「更新时间」对齐的每日批次（Asia/Shanghai）
DATA_UPDATE_TIME=07:00

# 管理后台 /admin（留空则后台不可用）
ADMIN_PASSWORD=

# --- 运营脚本调参（可选）---
# AI_CONCURRENCY=5            # ai:generate / ai:detail 并发
# F10_CONCURRENCY=6  F10_DELAY_MS=200
# HOLD_CONCURRENCY=4 HOLD_DELAY_MS=250
# MGR_CONCURRENCY=4  MGR_DELAY_MS=250
# FEE_CONCURRENCY=4  FEE_DELAY_MS=250
# EMBED_BATCH=8      EMBED_DELAY_MS=200
# FORCE=1                     # backfill 脚本重抓已抓过的
# AGENT_TEST_BASE=http://127.0.0.1:5173   # agent:test 目标服务
# AGENT_TEST_TOKEN=           # agent:test 用的登录用户 access_token（需已配 BYOK）
